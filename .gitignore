# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-3417/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# patient registry (health data, never commit)
/data

# pod Wi-Fi credentials
hardware/pod-firmware/secrets.h

# SpacetimeDB module build output and packages
node_modules
spacetime/spacetimedb/dist
/.next-prod/
/dist-app/
desktop/project-root.txt

# mosquito classifier's Python environment (rebuilt from tools/mosquito/requirements.txt)
tools/mosquito/.venv/

# settlements raw downloads (regenerate with tools/settlements/fetch.py)
tools/settlements/raw/
.next-prod-prev/
.next-staging/
dist-app/
.next-prod*/
.next-*/
